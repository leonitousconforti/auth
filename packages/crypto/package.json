{
  "name": "@yielded/crypto",
  "version": "0.1.0-beta.46",
  "description": "Bounded password derivation with native and portable Argon2id and scrypt backends.",
  "homepage": "https://yielded.dev/auth/",
  "bugs": {
    "url": "https://github.com/yielded-dev/auth/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yielded-dev/auth.git",
    "directory": "packages/crypto"
  },
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./Errors": "./src/Errors.ts",
    "./Kdf": "./src/Kdf.ts",
    "./KdfAdmission": "./src/KdfAdmission.ts",
    "./platform-node": "./src/platform-node.ts",
    "./platform-bun": "./src/platform-bun.ts",
    "./platform-workerd": "./src/platform-workerd.ts",
    "./Portable": "./src/Portable.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:wasm": "clang --target=wasm32 -O3 -msimd128 -ffreestanding -fno-builtin -nostdlib -Wl,--no-entry -Wl,--import-memory -Wl,--export=argon2_block -Wl,--export=__heap_base -Wl,--strip-all src/internal/argon2-block.c -o src/internal/argon2.wasm",
    "check": "effect-tsrs diagnostics --project tsconfig.json --type-check --strict",
    "test": "vp test"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  }
}
